# Polling interval in seconds (default: 5)
POLL_INTERVAL=5

# Wallet -> Telegram bot mappings.
# A JSON array; each entry pairs one wallet with its own bot token + chat IDs.
#   label     - nickname shown at the top of each alert (optional)
#   wallet    - Polymarket wallet address to monitor
#   bot_token - Telegram bot token from @BotFather (this wallet's bot)
#   chat_ids  - list of chat IDs that bot sends to
# Keep this on a single line.
WALLETS_CONFIG='[{"label":"Wallet A","wallet":"0xYourFirstWalletHere","bot_token":"111:AAA_bot_token_for_wallet_A","chat_ids":["123456789"]},{"label":"Wallet B","wallet":"0xYourSecondWalletHere","bot_token":"222:BBB_bot_token_for_wallet_B","chat_ids":["987654321"]}]'
